{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "infynix-solutions.com" }], "destination": "https://infynixgrowthsolutions.com/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.infynix-solutions.com" }], "destination": "https://infynixgrowthsolutions.com/$1", "permanent": true },
    { "source": "/what-we-do", "destination": "/growth-engineering", "permanent": true },
    { "source": "/future-of-growth-systems", "destination": "/growth-engineering", "permanent": true },
    { "source": "/news", "destination": "/insights", "permanent": true },
    { "source": "/services", "destination": "/solutions", "permanent": true },
    { "source": "/portfolio", "destination": "/case-studies", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/who-we-are", "destination": "/about", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    }
  ]
}